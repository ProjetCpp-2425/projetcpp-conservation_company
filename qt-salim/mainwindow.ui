     <widget class="QTableView" name="tableView">
      <property name="geometry">
       <rect>
        <x>370</x>
        <y>280</y>
        <width>821</width>
        <height>271</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">QTableWidget {
    background-color: #D8F1E6;  /* Light green background for table */
    border: 1px solid #A5D6A7;  /* Green border */
    border-radius: 10px;        /* Rounded corners for smooth look */
    gridline-color: #A5D6A7;    /* Color of grid lines */
    font-size: 14px;            /* Font size for table text */
}

QHeaderView::section {
    background-color: #A5D6A7;  /* Slightly darker green for headers */
    color: #333333;             /* Dark gray text color for readability */
    font-weight: bold;          /* Bold text for headers */
    padding: 8px;               /* Padding inside header cells */
    border-bottom: 1px solid #D8F1E6;  /* Bottom border to separate headers */
}

QTableWidget::item {
    padding: 8px;               /* Padding inside each cell */
    color: #333333;             /* Dark gray color for cell text */
    selection-background-color: #B2EBF2;  /* Light cyan for selected rows */
    selection-color: #333333;   /* Text color when row is selected */
}

QPushButton {
    border-radius: 5px;         /* Rounded corners for buttons */
    padding: 8px 16px;          /* Padding for buttons */
    color: white;               /* White text color */
    font-weight: bold;          /* Bold text for buttons */
    font-size: 12px;            /* Font size for buttons */
}

QPushButton#modifyButton {
    background-color: #4CAF50;  /* Green for the &quot;Modify&quot; button */
}

QPushButton#deleteButton {
    background-color: #FF5252;  /* Red for the &quot;Delete&quot; button */
}

QPushButton#viewAllButton {
    background-color: #B0BEC5;  /* Gray-blue for the &quot;View All&quot; button */
}

QPushButton:hover {
    opacity: 0.9;               /* Slight fade effect on hover */
}

QPushButton:pressed {
    background-color: #388E3C;  /* Darker green when the &quot;Modify&quot; button is pressed */
    border: 1px solid #2E7D32;  /* Darker border on press for the &quot;Modify&quot; button */
}

</string>
      </property>
     </widget>
