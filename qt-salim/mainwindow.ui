     <property name="styleSheet">
      <string notr="true">/* Default Style for the Button */
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
    color: Black;                        /* Black text */
    border-radius: 10px;                 /* Rounded corners */
    font-size: 15px;                     /* Font size */
    padding: 8px 16px;                   /* Comfortable padding */
    border: 2px solid rgba(150, 150, 150, 255); /* Light gray border */
}

/* Pressed Effect for the Button */
QPushButton:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(200, 200, 200, 255), stop:1 rgba(150, 150, 150, 255));
    border-color: rgba(100, 100, 100, 255);    /* Darker border when pressed */
    padding-top: 10px;                        /* Adjust padding to simulate press */
    padding-bottom: 4px;
}
</string>
