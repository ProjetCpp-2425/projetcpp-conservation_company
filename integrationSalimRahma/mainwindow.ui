       <widget class="QLineEdit" name="lineEdit_S">
        <property name="geometry">
         <rect>
          <x>370</x>
          <y>220</y>
          <width>331</width>
          <height>31</height>
         </rect>
        </property>
        <property name="styleSheet">
         <string notr="true">/* Style général pour le QLineEdit blanc avec ombre */
QLineEdit {
    background-color: #FFFFFF;                /* Arrière-plan blanc */
    color: #333333;                           /* Texte gris foncé */
    border: 1px solid #CCCCCC;                /* Bordure principale grise claire */
    border-radius: 5px;                       /* Coins arrondis */
    padding: 5px 10px;                        /* Espacement interne */
    font-size: 14px;                          /* Taille de la police */
    
    /* Effet de double bordure ou ombre */
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1), /* Ombre douce grise */
                inset 0px 0px 0px 1px #FFFFFF;  /* Bordure blanche intérieure */
}

/* Effet de survol */
QLineEdit:hover {
    border: 1px solid #AAAAAA;                /* Bordure légèrement plus foncée au survol */
    box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.15), /* Ombre renforcée au survol */
                inset 0px 0px 0px 1px #FFFFFF;  /* Bordure blanche intérieure */
}

/* Style du texte de remplacement (placeholder) */
QLineEdit::placeholder {
    color: #AAAAAA;                           /* Texte placeholder en gris clair */
    font-style: italic;                       /* Italique pour le texte placeholder */
}
</string>
        </property>
