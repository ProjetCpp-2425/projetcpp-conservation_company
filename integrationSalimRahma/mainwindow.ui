        <property name="styleSheet">
         <string notr="true">/* Default Style for the Red Button */
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 rgba(255, 102, 102, 255), 
                                      stop:1 rgba(204, 0, 0, 255));    /* Red gradient */
    color: white;                                 /* White text */
    border-radius: 10px;                          /* Rounded corners */
    font-size: 15px;                              /* Font size */
    padding: 8px 16px;                            /* Comfortable padding */
    border: 2px solid rgba(150, 0, 0, 255);       /* Dark red border */
}

/* Pressed Effect for the Red Button */
QPushButton:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 rgba(204, 0, 0, 255), 
                                      stop:1 rgba(153, 0, 0, 255));   /* Darker red on press */
    border-color: rgba(100, 0, 0, 255);           /* Darker border when pressed */
    padding-top: 10px;                            /* Adjust padding to simulate press */
    padding-bottom: 4px;                          /* Adjust padding to simulate press */
}
</string>
