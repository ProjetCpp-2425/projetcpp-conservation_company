        <widget class="QDateEdit" name="dateEdit">
         <property name="geometry">
          <rect>
           <x>130</x>
           <y>360</y>
           <width>181</width>
           <height>31</height>
          </rect>
         </property>
         <property name="styleSheet">
          <string notr="true">/* Style général pour le QDateEdit */
QDateEdit {
    background-color: #A8E6CF;             /* Vert menthe doux pour l'arrière-plan */
    color: #004D40;                        /* Texte en vert foncé */
    border: 1px solid #81C784;             /* Bordure vert doux */
    border-radius: 5px;                    /* Coins arrondis */
    padding: 5px 10px;                     /* Espacement interne pour le texte */
    font-size: 14px;                       /* Taille de la police */
}

/* Effet de survol pour QDateEdit */
QDateEdit:hover {
    background-color: #98DBC6;             /* Vert menthe légèrement plus foncé au survol */
    border: 1px solid #388E3C;             /* Bordure plus foncée au survol */
}

/* Style pour la flèche déroulante du QDateEdit */
QDateEdit::drop-down {
    border: none;                          /* Pas de bordure pour le menu déroulant */
    background-color: #81C784;             /* Fond vert moyen pour la flèche */
    border-top-right-radius: 5px;          /* Coins arrondis en haut à droite */
    border-bottom-right-radius: 5px;       /* Coins arrondis en bas à droite */
    width: 20px;                           /* Largeur de la zone de la flèche */
}

/* Icône de la flèche */
QDateEdit::down-arrow {
    image: url(&quot;:/icons/down-arrow.png&quot;);  /* Remplacez avec le chemin de votre icône */
    width: 10px;                           /* Largeur de l'icône */
    height: 10px;                          /* Hauteur de l'icône */
}
