        <property name="styleSheet">
         <string notr="true">/* Style par défaut pour le bouton vert doux */
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 rgba(200, 255, 200, 255),  /* Vert très clair */
                                      stop:1 rgba(120, 200, 120, 255)); /* Vert moyen */
    color: #004D40;                              /* Texte vert foncé */
    border-radius: 10px;                         /* Coins arrondis */
    font-size: 15px;                             /* Taille de la police */
    padding: 8px 16px;                           /* Espacement confortable */
    border: 2px solid rgba(120, 200, 120, 255);  /* Bordure vert moyen */
}

/* Effet Pressé pour le bouton vert doux */
QPushButton:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 rgba(170, 225, 170, 255),  /* Vert un peu plus foncé */
                                      stop:1 rgba(100, 180, 100, 255)); /* Vert plus foncé */
    border-color: rgba(100, 180, 100, 255);       /* Bordure vert foncé en pressant */
    padding-top: 10px;                            /* Ajustement du padding pour l’effet pressé */
    padding-bottom: 4px;
}
</string>
