        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-color: #E0F7FA;               /* Soft cyan background */
    color: #004D40;                          /* Dark teal text color */
    border-radius: 8px;                      /* Rounded corners */
    font-size: 14px;                         /* Font size */
    padding: 8px 16px;                       /* Comfortable padding */
    font-weight: bold;                       /* Slightly bold text */
    border: 1px solid #B2DFDB;               /* Light teal border */
    /* Simulate shadow effect */
    margin: 2px 2px;                         /* Slight offset to enhance effect */
    border-bottom: 3px solid rgba(0, 0, 0, 0.15); /* Bottom border for shadow effect */
}

QPushButton:hover {
    background-color: #B2EBF2;               /* Slightly darker on hover */
    border-bottom: 3px solid rgba(0, 0, 0, 0.25); /* Stronger shadow on hover */
}

QPushButton:pressed {
    background-color: #A7D8DE;               /* Darker background on press */
    border: 1px solid #81C784;               /* Change border color on press */
    margin: 1px 1px;                         /* Move slightly up on press */
    border-bottom: none;                     /* Remove shadow on press */
}
</string>
