         <property name="styleSheet">
          <string notr="true">/* General Style for QComboBox */
QComboBox {
    background-color: #A8E6CF;             /* Soft mint green for the main background */
    color: #004D40;                        /* Dark teal text color */
    border: 1px solid #81C784;             /* Soft green border */
    border-radius: 5px;                    /* Rounded corners */
    padding: 5px 10px;                     /* Inner padding for text */
    font-size: 14px;                       /* Font size */
}

/* Dropdown Arrow Style */
QComboBox::drop-down {
    border: none;                          /* Remove border around the dropdown arrow */
    background-color: #81C784;             /* Light green background for the arrow area */
    border-top-right-radius: 5px;          /* Rounded top right corner */
    border-bottom-right-radius: 5px;       /* Rounded bottom right corner */
    width: 25px;                           /* Width of the dropdown area */
}

/* Arrow Icon */
QComboBox::down-arrow {
    image: url(&quot;:/icons/down-arrow.png&quot;);  /* Replace with the path to your arrow icon */
    width: 12px;                           /* Icon width */
    height: 12px;                          /* Icon height */
}

/* Style for Dropdown Items */
QComboBox QAbstractItemView {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 #E8F5E9, 
                                      stop:1 #A5D6A7);  /* Light gradient green for dropdown */
    border: 1px solid #66BB6A;             /* Medium green border */
    selection-background-color: #66BB6A;   /* Highlighted green for selected item */
    selection-color: white;                /* White text for selected item */
    color: #004D40;                        /* Dark teal text for items */
}

/* Hover Effect */
QComboBox:hover {
    background-color: #98DBC6;             /* Slightly darker mint green on hover */
    border: 1px solid #388E3C;             /* Darker border on hover */
}
</string>
